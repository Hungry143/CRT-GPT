# GEMINI_API_KEY: Reserved for server-side environment configuration only.
# Stage 1 & Stage 2A do NOT call the Gemini API for trading decisions or signal generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Stage 1 & Stage 2A Feature Gates (all default strictly to false when unset)
MARKET_FEED_ENABLED="false"
CRT_ENGINE_ENABLED="false"
SIGNALS_ENABLED="false"
BACKFILL_ENABLED="false"

# Stage 2A Market Data Adapter Configuration (server-only; never expose to client)
# Allowed values: "none" (default) | "oanda_v20"
MARKET_DATA_PROVIDER="none"

# OANDA v20 Read-Only Market Data Secrets (server-only; leave blank for zero-credential Stage 2A/2B)
# Protect OANDA_API_TOKEN as a privileged secret even though only read-only market-data routes are called.
OANDA_ENV=""
OANDA_DIVISION=""
OANDA_ACCOUNT_ID=""
OANDA_API_TOKEN=""
OANDA_INSTRUMENT=""

# Optional Persistent PostgreSQL Store (server-only; when unset, History reports NOT_PERSISTENT)
DATABASE_URL=""
# Optional custom PEM root CA certificate for strict production PostgreSQL TLS verification
DATABASE_CA_CERT=""

# Optional Fail-Closed Staleness Threshold in seconds (defaults to 1800s / 30m for M15 feed status)
MARKET_STALE_THRESHOLD_SECONDS=""

# Temporary Private Dev/Preview OANDA PRACTICE Diagnostic (disabled by default; never enable in public production)
# Requires a separate strong server-side secret (>= 32 chars) distinct from OANDA_API_TOKEN and OANDA_ACCOUNT_ID.
OANDA_PRACTICE_DIAGNOSTIC_ENABLED="false"
OANDA_PRACTICE_DIAGNOSTIC_SECRET=""

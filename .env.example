# GEMINI_API_KEY: Reserved for server-side environment configuration only.
# Stage 1 does NOT call the Gemini API for trading decisions or signal generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Stage 1 Feature Gates (all default to false when unset)
MARKET_FEED_ENABLED="false"
CRT_ENGINE_ENABLED="false"
SIGNALS_ENABLED="false"
